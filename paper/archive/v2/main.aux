\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Benchmark harness overview. \textbf  {Top:} each session runs 11 tasks in a fixed sequence; annotations show what each task type tests. \textbf  {Middle:} the agent system receives each task as natural language, creates or reuses Python tools in a persistent library, and produces output. After the session, hidden tests and adversarial inputs independently evaluate the library. \textbf  {Bottom:} four metrics are computed: task completion (TC) from outputs, per-tool quality (TQS) from hidden tests, library health (LH) from library state, and the composite EvolveTool Score (ETS).}}{4}{figure.caption.9}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{4}{Benchmark harness overview. \textbf {Top:} each session runs 11 tasks in a fixed sequence; annotations show what each task type tests. \textbf {Middle:} the agent system receives each task as natural language, creates or reuses Python tools in a persistent library, and produces output. After the session, hidden tests and adversarial inputs independently evaluate the library. \textbf {Bottom:} four metrics are computed: task completion (TC) from outputs, per-tool quality (TQS) from hidden tests, library health (LH) from library state, and the composite EvolveTool Score (ETS)}{figure.caption.9}{}}
