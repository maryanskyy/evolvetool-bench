\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces System comparison across four metrics (\%). TC clusters all systems together (63--68\%); library health separates them (38--52\%). This illustrates the benchmark's discriminative power beyond task completion.}}{7}{figure.caption.28}\protected@file@percent }
